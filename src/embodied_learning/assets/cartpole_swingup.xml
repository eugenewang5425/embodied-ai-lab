<mujoco model="cartpole swingup">
  <!-- Same masses/geometries/transmission as Gymnasium's inverted pendulum.
       Full-rotation hinge; rail extended to [-2.5, 2.5] m for swing-up travel. -->
  <compiler inertiafromgeom="true" angle="degree"/>
  <default>
    <joint armature="0" damping="1" limited="true"/>
    <geom contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0 1"/>
    <motor ctrlrange="-3 3"/>
  </default>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>
  <worldbody>
    <geom name="rail" pos="0 0 0" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 2.5" type="capsule"/>
    <body name="cart" pos="0 0 0">
      <joint axis="1 0 0" name="slider" range="-2.5 2.5" type="slide"/>
      <geom name="cart" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
      <body name="pole" pos="0 0 0">
        <joint axis="0 1 0" name="hinge" limited="false" type="hinge"/>
        <geom fromto="0 0 0 0.001 0 0.6" name="cpole" rgba="0 0.7 0.7 1" size="0.049 0.3" type="capsule"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor ctrllimited="true" ctrlrange="-3 3" gear="100" joint="slider" name="slide"/>
  </actuator>
</mujoco>
