<mujoco model="planar two-link arm">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="RK4" gravity="0 0 -9.81"/>
  <default>
    <joint type="hinge" axis="0 0 1" limited="false"/>
    <geom type="capsule" size="0.025" contype="0" conaffinity="0"/>
    <motor ctrllimited="true" ctrlrange="-0.25 0.25" gear="1"/>
  </default>
  <!-- Horizontal XY plane; rigid base; no contact or joint-angle limits in this lesson. -->
  <worldbody>
    <body name="upper_arm" pos="0 0 0.1">
      <joint name="shoulder" damping="0.1" armature="0.01"/>
      <geom name="link1" fromto="0 0 0 0.4 0 0" mass="1" rgba="0.15 0.4 0.9 1"/>
      <site name="base" size="0.015" pos="0 0 0"/>
      <body name="forearm" pos="0.4 0 0">
        <joint name="elbow" damping="0.08" armature="0.005"/>
        <geom name="link2" fromto="0 0 0 0.3 0 0" mass="0.7" rgba="0.05 0.6 0.5 1"/>
        <site name="elbow_point" size="0.015" pos="0 0 0"/>
        <site name="tip" size="0.025" pos="0.3 0 0" rgba="0.9 0.3 0.1 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder"/>
    <motor name="elbow_motor" joint="elbow"/>
  </actuator>
</mujoco>
